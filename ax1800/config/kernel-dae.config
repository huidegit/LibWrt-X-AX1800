# dae 需要的内核能力（只有 12M 分区装得下，6M 会溢出）
#
# 现在只开内核侧；dae 本体和 luci-app-dae 以后单独装
# （BTF/XDP 打开后，装包时 dae 的 @HAS_BPF_TOOLCHAIN 依赖才成立）。
#
# 用法：cat ax1800/config/kernel-dae.config >> .config  然后 make defconfig
CONFIG_KERNEL_DEBUG_INFO=y
CONFIG_KERNEL_DEBUG_INFO_BTF=y
# DEBUG_INFO_REDUCED 默认 y，而 BTF depends on !REDUCED —— 不显式关掉，BTF 永远选不上
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_XDP_SOCKETS=y
CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_KPROBE_EVENTS=y
CONFIG_KERNEL_BPF_EVENTS=y

# ---- 1GB 设备内存与 NSS 性能优化（ZqinKing 亚瑟档案同款，2026-11-08 挖掘）----
# 符号均已在 LibWrt 树内验证存在（NSS 补丁 / ath.mk / nss_packages）
CONFIG_IPQ_MEM_PROFILE_256=y
# SoC 内存画像 256M 档：内核缓冲更保守，1GB 硬改机可用内存更多
CONFIG_ATH11K_MEM_PROFILE_512M=y
# ath11k WiFi 驱动小内存方案
CONFIG_NSS_MEM_PROFILE_HIGH=y
# NSS NAT 表项高配（1GB 内存撑得住）
CONFIG_NSS_FIRMWARE_VERSION_11_4=y
# 钉 NSS 固件 11.4（与 laipeng668 nss_packages 11.4 匹配）
CONFIG_KERNEL_SKB_RECYCLER=y
CONFIG_KERNEL_SKB_RECYCLER_MULTI_CPU=y
# SKB 回收器：QSDK NAT 性能利器（多核减少 skb 分配开销）
CONFIG_NSS_DRV_WIFI_MESH_ENABLE=y
CONFIG_ATH11K_NSS_MESH_SUPPORT=y
CONFIG_PACKAGE_MAC80211_MESH=y
# NSS Mesh 卸载（双频合一/mesh 场景）
CONFIG_PACKAGE_kmod-qca-mcs=y
# NSS 组播卸载
# 注：NSS PPPoE/PPTP 卸载已在 LibWrt target 默认包里（qualcommax/Makefile:30-31），无需重复

# ---- SQM 硬件整形链修复（BUG#2 真根因，2026-11-08 定位）----
# target 默认包本含 kmod-qca-nss-drv-qdisc（NSS QoS 整形），但 ALL_KMODS=y 会把
# 没被显式指定的 kmod 压成 =m（编出不装）→ 依赖它的 sqm-scripts-nss 被连带降级
# → 整条 NSS 硬件 SQM 链静默消失。显式给 =y 顶回 ALL_KMODS 的压制。
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
