# 选中的软件包
# 用法：cat ax1800/config/packages.config >> .config
# 说明：默认就进固件的（base-files / dropbear / luci / NSS 全套 / autocore / automount /
#      cpufreq / wpad-openssl / kmod-ath11k* …）不在这里重复写。

# ---- 全部内核模块都编 ----
# 自编译内核的 kmod 和内核哈希绑死，公共源里永远对不上，只能自带。
# 全编的产物是 m（编译但不装进 rootfs），镜像不变，全部进 apk-repo 供按需安装。
CONFIG_ALL_KMODS=y

# ---- 代理 ----
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
# PassWall 依赖的 kmod（nft-nat / nf-reject / nf-reject6 / nft-tproxy 本来就有，缺这三个）
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-ipt-nat=y
# PassWall 本体（feed 见 workflow 的 feeds 步骤；xray/sing-box 等核心运行时由它在 LuCI 里自己下）
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y

# ---- 网络 ----
# NSS 子模块全家桶显式 =y：ALL_KMODS 会把没被显式指定的 kmod 压成 =m（编出不装），
# 而 target 默认包（bridge-mgr/lag-mgr/vlan-mgr/qdisc/igs/netlink/pppoe）依赖
# bonding/qdisc 等基座 —— 不显式 =y 就会被连带降级（BUG#2，真机 2026-11-08 实证）
# 内核 TLS 层：kmod-bonding 的硬依赖，缺了它 bonding 降级 → 整棵 NSS 子模块树级联消失
CONFIG_PACKAGE_kmod-tls=y
CONFIG_PACKAGE_kmod-bonding=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-lag-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-netlink=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_luci-app-usteer=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts-aliyun=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_ddns-scripts-dnspod-v3=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_sqm-scripts-nss=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-wifihistory=y

# ---- 全锥 NAT1（LibWrt 自带 firewall4 补丁 + fullconenat-nft）----
CONFIG_PACKAGE_kmod-nft-fullcone=y

# ---- 存储 / 下载 / 挂载 ----
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_automount=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-dwc3-qcom=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-nls-cp936=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_exfat-fsck=y
CONFIG_PACKAGE_exfat-mkfs=y
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_btrfs-progs=y

# ---- 远程 ----
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-wireguard=y

# ---- 系统 / 工具 ----
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_cfdisk=y
CONFIG_PACKAGE_sgdisk=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_curl=y

# ---- 中文界面 ----
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y
CONFIG_PACKAGE_luci-i18n-usteer-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wifihistory-zh-cn=y
# argon 3.x 的设置页已并进主题包（luci-app-argon-config 已卸载），没有对应的 i18n 包，写了也是死配置
CONFIG_PACKAGE_luci-i18n-commands-zh-cn=y

# ---- ALL_KMODS 里编不过的两个 ----
# kmod-ath10k-sdio / kmod-ath6kl-sdio 会拉起 backports-6.18.55 的 sdio 变体，
# 而 drivers/net/wireless/ath/ath10k/sdio.c:1867 在 6.12.112 上
# dev_set_threaded 参数类型不兼容，直接编挂（run 42332557252）。
# 这台机器的无线是 ath11k PCIe，SDIO 变体本来就用不到。
# CONFIG_PACKAGE_kmod-ath10k-sdio is not set
# CONFIG_PACKAGE_kmod-ath6kl-sdio is not set
# open-app-filter / kmod-oaf 用 -Werror 编译，本树 GCC 下 missing-prototypes 直接报错
# （run 42344871011），这台机器用不到 DPI 过滤，关掉。
# CONFIG_PACKAGE_kmod-oaf is not set
# CONFIG_PACKAGE_open-app-filter is not set
# ---- ALL_KMODS 里编不过的三个 USB/SDIO WiFi 驱动 ----
# 厂商老驱动追不上 6.12.112 + 新 GCC，每轮构建必挂三行 ERROR（2026-11-08 起
# 由 IGNORE_ERRORS=m 跳过）。本机用 ath11k（PCIe），这些 USB/SDIO 芯片永远用不到，
# 显式关闭让构建日志干净。注意 aic8800 要连子变体一起关，只关核心的话
# 依赖它的 =m 变体仍会被编、仍会挂。
# CONFIG_PACKAGE_kmod-aic8800 is not set
# CONFIG_PACKAGE_kmod-aic8800-btusb is not set
# CONFIG_PACKAGE_kmod-aic8800-pcie is not set
# CONFIG_PACKAGE_kmod-aic8800-sdio is not set
# CONFIG_PACKAGE_kmod-aic8800-usb is not set
# CONFIG_PACKAGE_kmod-rtl8189es is not set
# CONFIG_PACKAGE_kmod-rtl8188eu is not set
