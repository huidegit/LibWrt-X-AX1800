#!/bin/sh
# AX1800 IPv6 / 中文配置重放（必须在 99-default-settings-chinese 之后执行）
#
# 为什么有这个文件：uci-defaults 按文件名字典序执行，99-ax1800（a）先于
# 99-default-settings-chinese（d）——后者会重写 dhcp.lan 整个 section 并重置
# luci.main.lang，把 99-ax1800 的设置抹掉（2026-11-08 真机实证）。
# 99-ax1800 的 apk_mirror 钉扎又依赖它先跑（对方的 sed 变成空操作），
# 所以不能整体改名，只能用本文件在其之后重放设计值。
#
# 文件名 zz > 99-default-settings-chinese 的 "d"，保证最后执行。

# ---- IPv6：恢复 RA + stateful DHCPv6 设计值 ----
uci set dhcp.lan.dhcpv6='server' 2>/dev/null
uci set dhcp.lan.ra='server' 2>/dev/null
uci -q delete dhcp.lan.ra_flags 2>/dev/null
uci add_list dhcp.lan.ra_flags='managed-config' 2>/dev/null
uci add_list dhcp.lan.ra_flags='other-config' 2>/dev/null
uci set dhcp.lan.ra_default='1' 2>/dev/null
uci commit dhcp

# ---- LuCI 语言钉回 zh-cn（lang=auto 会跟随浏览器语言，非中文浏览器整个界面变英文）----
uci set luci.main.lang='zh-cn' 2>/dev/null
uci commit luci

# ---- usteer 菜单标题中文化（overlayfs 下 sed -i 对 ROM 文件写白出，有效）----
sed -i 's/"title": "Usteer"/"title": "无线漫游"/' \
	/usr/share/luci/menu.d/luci-app-usteer.json 2>/dev/null

# ---- 清一次 LuCI 菜单缓存（让 menu.d 修改生效）----
rm -rf /tmp/luci-indexcache* 2>/dev/null

exit 0
