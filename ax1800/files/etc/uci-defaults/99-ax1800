#!/bin/sh
# AX1800 Pro 首启配置（OpenWrt uci-defaults，只执行一次）
#
# 覆盖面：主机名/时区、LAN 地址、root 密码、IPv6、WAN（默认 DHCP，以后改 PPPoE）、
#        全锥 NAT1、双频合一 WiFi（SSID CLI / WPA2+WPA3 混合 / 12345678）、主题。
#
# 注意：不要用 set -e —— uci 在某个 section 不存在时返回非零，会把整段掐断。

MARK=/etc/config/.ax1800-inited
[ -f "$MARK" ] && exit 0

log() { echo "[ax1800] $*"; }

# ---------- 1. 系统 ----------
uci set system.@system[0].hostname='OpenWrt' 2>/dev/null
uci set system.@system[0].timezone='CST-8' 2>/dev/null
uci set system.@system[0].zonename='Asia/Shanghai' 2>/dev/null
uci -q delete system.ntp.server 2>/dev/null
uci add_list system.ntp.server='ntp.aliyun.com' 2>/dev/null
uci add_list system.ntp.server='cn.pool.ntp.org' 2>/dev/null
uci commit system

# ---------- 1.5 包源 ----------
# LibWrt 的 default-settings-chn 首启会把 /etc/apk/repositories.d/distfeeds.list
# 里的 downloads.immortalwrt.org 换成 system.@imm_init[0].apk_mirror，它的默认值
# 是 mirrors.vsean.net —— 那个域名现在只回一个跟不过去的 302，apk 拿不到
# packages.adb（wget error 8 / unexpected end of file），整个事务就记 1 个 error。
# 这里先把它钉成官方源，那个脚本的 sed 就变成空操作。
# 本文件排在 99-default-settings-chinese 之前（uci-defaults 按文件名顺序执行）。
if ! uci -q get system.@imm_init[0] >/dev/null 2>&1; then
	uci add system imm_init >/dev/null 2>&1
fi
uci set system.@imm_init[0].apk_mirror='https://downloads.immortalwrt.org' 2>/dev/null
uci commit system

# ---------- 2. root 密码 ----------
# 构建时注入；没配 Secret(ROOT_PASSWORD) 时默认 root。
ROOT_PW='__ROOT_PASSWORD__'
if [ -n "$ROOT_PW" ]; then
	printf '%s\n%s\n' "$ROOT_PW" "$ROOT_PW" | passwd root >/dev/null 2>&1 \
		&& log "root 密码已设置"
fi

# ---------- 3. 网络：LAN 固定 192.168.1.1，WAN 默认 DHCP ----------
uci set network.lan.ipaddr='192.168.1.1' 2>/dev/null
uci set network.lan.netmask='255.255.255.0' 2>/dev/null
uci set network.lan.ip6assign='60' 2>/dev/null
uci set network.lan.delegate='1' 2>/dev/null
uci set network.wan.proto='dhcp' 2>/dev/null
uci set network.wan6.proto='dhcpv6' 2>/dev/null
uci commit network

# ---------- 4. IPv6：LAN 侧 RA + DHCPv6 ----------
uci set dhcp.lan.dhcpv6='server' 2>/dev/null
uci set dhcp.lan.ra='server' 2>/dev/null
# ra_flags 是 list 选项：必须 add_list 逐条加。写成含空格的单字符串，
# odhcpd 解析不出 M/O 标志，"managed-config other-config" 会被当成一个未知 flag 丢弃
uci -q delete dhcp.lan.ra_flags 2>/dev/null
uci add_list dhcp.lan.ra_flags='managed-config' 2>/dev/null
uci add_list dhcp.lan.ra_flags='other-config' 2>/dev/null
uci set dhcp.lan.ra_default='1' 2>/dev/null
uci commit dhcp

# ---------- 5. 全锥 NAT1 ----------
# LibWrt 的 firewall4 带 fullcone 补丁，fullconenat-nft 提供 kmod-nft-fullcone。
# IPv6 不走全锥（fullcone6=0），IPv4 打开即为 NAT1。
uci set firewall.@defaults[0].fullcone='1' 2>/dev/null
uci set firewall.@defaults[0].fullcone6='0' 2>/dev/null
# 代理要接管流量时不能开软件卸载，这里保持关闭（硬件加速由 NSS 负责）
uci set firewall.@defaults[0].flow_offloading='0' 2>/dev/null
uci set firewall.@defaults[0].flow_offloading_hw='0' 2>/dev/null
uci commit firewall

# ---------- 6. 无线：双频合一 ----------
# 首次开机会话里 /etc/config/wireless 可能还没生成，先让 wifi 脚本补出来
[ -f /etc/config/wireless ] || wifi config >/dev/null 2>&1

i=0
while uci -q get "wireless.@wifi-device[$i]" >/dev/null 2>&1; do
	band=$(uci -q get "wireless.@wifi-device[$i].band")
	uci set "wireless.@wifi-device[$i].disabled=0" 2>/dev/null
	uci set "wireless.@wifi-device[$i].country=CN" 2>/dev/null
	uci set "wireless.@wifi-device[$i].channel=auto" 2>/dev/null
	case "$band" in
		2g)
			# 2.4G 只跑 20MHz：40MHz 在拥挤环境里反而更慢。
			# 用 HE20 而不是 HT20——HT20 会让 mac80211 不开 ieee80211ax，2.4G 退回 11n（≈144Mbps 上限）
			uci set "wireless.@wifi-device[$i].htmode=HE20" 2>/dev/null
			uci set "wireless.@wifi-device[$i].noscan=0" 2>/dev/null
			;;
		5g)
			# 5G 跑 HE80：160MHz 在 IPQ6000 上受 DFS/干扰影响，实测更差
			uci set "wireless.@wifi-device[$i].htmode=HE80" 2>/dev/null
			# 受限 ACS：候选限在非 DFS 集合（真机 2026-11-08 实测 auto 会落在
			# DFS 信道 60，不支持 DFS 的手机/网卡完全看不到 5G SSID）。
			# channels 是 list 选项：先清再逐条 add_list，保证重跑幂等。
			uci -q delete "wireless.@wifi-device[$i].channels" 2>/dev/null
			uci add_list "wireless.@wifi-device[$i].channels=149" 2>/dev/null
			uci add_list "wireless.@wifi-device[$i].channels=153" 2>/dev/null
			uci add_list "wireless.@wifi-device[$i].channels=157" 2>/dev/null
			uci add_list "wireless.@wifi-device[$i].channels=161" 2>/dev/null
			;;
	esac
	i=$((i + 1))
done

i=0
while uci -q get "wireless.@wifi-iface[$i]" >/dev/null 2>&1; do
	uci set "wireless.@wifi-iface[$i].ssid=CLI" 2>/dev/null
	uci set "wireless.@wifi-iface[$i].key=12345678" 2>/dev/null
	# WPA2-PSK + WPA3-SAE 混合；需要 wpad-openssl（目标默认，支持 SAE）
	uci set "wireless.@wifi-iface[$i].encryption=sae-mixed" 2>/dev/null
	# 11k/11v 开（配合 usteer 做频段引导），11r 关（单机用不上，老设备还可能连不上）
	uci set "wireless.@wifi-iface[$i].ieee80211k=1" 2>/dev/null
	uci set "wireless.@wifi-iface[$i].bss_transition=1" 2>/dev/null
	uci set "wireless.@wifi-iface[$i].ieee80211r=0" 2>/dev/null
	# SAE 需要 PMF 能力，用可选（1）而不是强制（2），兼容老客户端
	uci set "wireless.@wifi-iface[$i].ieee80211w=1" 2>/dev/null
	uci set "wireless.@wifi-iface[$i].isolate=0" 2>/dev/null
	i=$((i + 1))
done
uci commit wireless

# ---------- 7. LuCI / 主题 ----------
uci set luci.main.mediaurlbase='/luci-static/argon' 2>/dev/null
uci set luci.main.lang='zh-cn' 2>/dev/null
uci commit luci

# ---------- 7.5 守护进程 ----------
# usteer 的 LuCI 页面调的是它自己的 ubus 对象（usteer.remote_hosts …），
# 守护进程没起来就会报 "No related RPC reply"。
if [ -x /etc/init.d/usteer ]; then
	/etc/init.d/usteer enable  >/dev/null 2>&1
	/etc/init.d/usteer restart >/dev/null 2>&1
fi
# luci.ddns / luci.getDHCPLeases 这些对象来自 /usr/libexec/rpcd/ 下的脚本，
# 首次开机后重新加载一次，避免页面报 RPC 无响应。
/etc/init.d/rpcd reload >/dev/null 2>&1

# ---------- 8. 应用 ----------
wifi reload >/dev/null 2>&1 || wifi up >/dev/null 2>&1
/etc/init.d/firewall restart >/dev/null 2>&1
/etc/init.d/dnsmasq restart >/dev/null 2>&1

# 自检：uci set "键='值'" 会把单引号写进值里（2026-11-03 那版固件就是这么坏的：
# /etc/config/wireless 里出现 channel ''''auto''''，hostapd 解析失败，两个 radio 全禁用）
bad=0
# 两个 radio 都就位才算配好：ath11k 的 5G phy 注册可能晚于 uci-defaults，
# 缺的那个只会拿到 hotplug 生成的默认配置（disabled）。不写标记，下次开机重试。
n=0
while uci -q get "wireless.@wifi-device[$n]" >/dev/null 2>&1; do
	n=$((n + 1))
done
if [ "$n" -lt 2 ]; then
	log "错误：只检测到 $n 个 radio（应有 2 个），下次开机重试"
	bad=1
fi
for k in wireless.@wifi-device[0].channel wireless.@wifi-device[0].htmode          wireless.@wifi-iface[0].ssid wireless.@wifi-iface[0].encryption          wireless.@wifi-iface[0].key; do
	v=$(uci -q get "$k")
	case "$v" in
		*"'"*) log "错误：$k 的值里带引号（$v），配置写坏了"; bad=1 ;;
	esac
done
if [ "$bad" != 0 ]; then
	log "首启配置自检失败，未写标记，下次开机会重试"
	exit 1
fi

touch "$MARK"
log "首启配置完成：192.168.1.1 / IPv6 / NAT1 / SSID CLI / WPA2+WPA3 混合"
exit 0
